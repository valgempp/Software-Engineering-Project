# Copy to .env and adjust. Never commit .env.

# Express API (the Vite dev server proxies /api to this port)
API_PORT=3000

# PostgreSQL (used by Docker Compose, and later by TypeORM)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_models_comparator
POSTGRES_USER=aimc
POSTGRES_PASSWORD=change-me
