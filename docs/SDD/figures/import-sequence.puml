@startuml
!include style.iuml
hide footbox
participant "Scheduler\n(node-cron)" as Cron
participant ImportService as IS
participant "Benchmark\nSource API" as BS
database PostgreSQL as DB
Cron -> IS ++ : runBenchmarkImport()
IS -> DB ++ : get BENCHMARK sources
return sources
loop for each source
  IS -> BS ++ : GET /scores
  return JSON or error
  alt response is valid
    IS -> DB ++ : start transaction (dataSource.transaction)
    loop for each score
      IS -> DB : find alias (source, external name)
      alt alias linked to a model
        IS -> DB : upsert score (model, benchmark)
      else unknown name
        IS -> DB : save unlinked alias, skip score
      end
    end
    IS -> DB : set last_success_at = now()
    IS -> DB : end transaction
    deactivate DB
  else error or invalid data
    IS -> DB ++ : set last_error, keep old scores
    return ok
  end
end
IS -> DB ++ : RankingService: save benchmark\nscores and ranks in models
return ok
return done
@enduml
