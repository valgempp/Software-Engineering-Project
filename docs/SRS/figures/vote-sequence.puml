@startuml
!include style.iuml
hide footbox
actor User
participant "Web App" as UI
participant "Server" as API
database "Database" as DB
User -> UI ++ : click up or down arrow
alt not logged in
  UI --> User : show "Log in to vote"
else logged in
  UI -> API ++ : vote(slug, type)
  API -> DB ++ : find user of the session
  return user with status
  alt account BLOCKED
    API --> UI : error: account blocked, end session
    UI --> User : show "Your account is blocked"
  else account ACTIVE
    API -> DB ++ : find vote (user, model)
    return existing vote or null
    alt no previous vote
      API -> DB ++ : insert vote
      return ok
    else same type as before
      API -> DB ++ : delete vote
      return ok
    else other type
      API -> DB ++ : update vote type
      return ok
    end
    API -> DB ++ : save new community\nscores and ranks
    return new score and vote count
    API --> UI : score, vote count, my vote
    UI --> User : show new score and selected arrow
  end
  deactivate API
end
deactivate UI
@enduml
