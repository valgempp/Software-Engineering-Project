@startuml
!include style.iuml
hide footbox
actor Visitor
participant "Web App" as UI
participant "Server" as API
database "Database" as DB
Visitor -> UI ++ : open model page
UI -> API ++ : getModel(slug)
API -> DB ++ : find model by slug
return model with stored scores and ranks, or null
alt model not found
  API --> UI : error: not found
  UI --> Visitor : show "Model not found"
else model found
  API -> DB ++ : get lab, benchmark scores and sources
  return data
  API -> DB ++ : count votes
  return counts
  API --> UI : model, scores, ranks, votes
  deactivate API
  UI -> API ++ : getComments(slug, page 1)
  API -> DB ++ : get 20 newest comments
  return comments
  return comments
  UI --> Visitor : show model page
end
deactivate UI
@enduml
