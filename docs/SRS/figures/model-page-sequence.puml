@startuml
!include style.iuml
hide footbox
actor Visitor
participant "React App" as UI
participant "Express API" as API
database "PostgreSQL" as DB
Visitor -> UI ++ : open /models/{slug}
UI -> API ++ : GET /api/models/{slug}
API -> DB ++ : find model by slug
return model or null
alt model not found
  API --> UI : 404 Not Found
  UI --> Visitor : show "Model not found"
else model found
  API -> DB ++ : get lab, scores and sources
  return data
  API -> DB ++ : count votes
  return counts
  API -> API : compute ranks
  API --> UI : 200 {model, scores, ranks, votes}
  deactivate API
  UI -> API ++ : GET /api/models/{slug}/comments
  API -> DB ++ : get comments (newest first)
  return comments
  return 200 [comments]
  UI --> Visitor : show model page
end
deactivate UI
@enduml
