{
  "openapi": "3.0.3",
  "info": {
    "title": "AI Models Comparator API",
    "version": "1.0.0",
    "description": "REST API for comparing AI models and submitting model suggestions."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "Catalog"
    },
    {
      "name": "Suggestions"
    },
    {
      "name": "Benchmarks"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["Health"],
        "operationId": "getHealth",
        "summary": "Check API health",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/labs": {
      "get": {
        "tags": ["Catalog"],
        "operationId": "getLabs",
        "summary": "List available benchmark labs",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["labs"],
                  "properties": {
                    "labs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/models/{slug}": {
      "get": {
        "tags": ["Catalog"],
        "operationId": "getModelBySlug",
        "summary": "Get an AI model by its slug",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "HTTP 400",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "HTTP 404",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/model-suggestions": {
      "get": {
        "tags": ["Suggestions"],
        "operationId": "listModelSuggestions",
        "summary": "List model suggestions",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Suggestion"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Suggestions"],
        "operationId": "createModelSuggestion",
        "summary": "Create a model suggestion",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SuggestionInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Suggestion"
                }
              }
            }
          },
          "400": {
            "description": "HTTP 400",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/benchmarks": {
      "get": {
        "tags": ["Benchmarks"],
        "operationId": "listBenchmarks",
        "summary": "List model benchmark scores",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BenchmarkScore"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Benchmarks"],
        "operationId": "createBenchmark",
        "summary": "Create a model benchmark score",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BenchmarkScoreInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BenchmarkScore"
                }
              }
            }
          },
          "400": {
            "description": "HTTP 400",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "HTTP 404",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          }
        }
      },
      "Suggestion": {
        "type": "object",
        "required": ["id", "name", "provider"],
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "GPT-6"
          },
          "provider": {
            "type": "string",
            "example": "OpenAI"
          }
        }
      },
      "SuggestionInput": {
        "type": "object",
        "required": ["name", "provider"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "BenchmarkScore": {
        "type": "object",
        "required": ["modelSlug", "benchmarkName", "score", "unit", "source"],
        "properties": {
          "modelSlug": {
            "type": "string",
            "example": "aurora-lumen-2-demo"
          },
          "benchmarkName": {
            "type": "string",
            "example": "Demo Reasoning Set"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "example": 71.4
          },
          "unit": {
            "type": "string",
            "example": "%"
          },
          "source": {
            "type": "string",
            "nullable": true,
            "example": "Demo dataset (fictional)"
          }
        }
      },
      "BenchmarkScoreInput": {
        "type": "object",
        "required": ["modelSlug", "benchmarkName", "score"],
        "additionalProperties": false,
        "properties": {
          "modelSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "benchmarkName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
