{
  "openapi": "3.0.3",
  "info": {
    "title": "AI Models Comparator API",
    "version": "1.0.0",
    "description": "REST API for comparing AI models and submitting model suggestions."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "Catalog"
    },
    {
      "name": "Suggestions"
    },
    {
      "name": "Benchmarks"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["Health"],
        "operationId": "getHealth",
        "summary": "Check API health",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/labs": {
      "get": {
        "tags": ["Catalog"],
        "operationId": "getLabs",
        "summary": "List available benchmark labs",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["labs"],
                  "properties": {
                    "labs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/models": {
      "get": {
        "tags": ["Catalog"],
        "operationId": "listModels",
        "summary": "List the AI models of the catalogue, optionally for one lab",
        "parameters": [
          {
            "name": "lab",
            "in": "query",
            "required": false,
            "description": "Exact lab name; an unknown lab gives an empty list",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Models sorted by name",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CatalogModel"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Empty lab filter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Catalog"],
        "operationId": "createModel",
        "summary": "Add an AI model to an existing lab",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewModelInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Model created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogModel"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or missing required fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Lab not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Model slug already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/models/{slug}": {
      "get": {
        "tags": ["Catalog"],
        "operationId": "getModelBySlug",
        "summary": "Get an AI model by its slug",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "HTTP 400",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "HTTP 404",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/model-suggestions": {
      "get": {
        "tags": ["Suggestions"],
        "operationId": "listModelSuggestions",
        "summary": "List model suggestions",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Suggestion"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Suggestions"],
        "operationId": "createModelSuggestion",
        "summary": "Create a model suggestion",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SuggestionInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Suggestion"
                }
              }
            }
          },
          "400": {
            "description": "HTTP 400",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/comparisons": {
      "get": {
        "operationId": "compareModels",
        "summary": "Compare selected models in selection order",
        "parameters": [
          {
            "name": "models",
            "in": "query",
            "required": true,
            "description": "2 to 10 distinct model slugs separated by commas.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Comparison, including models with no benchmark measurements",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["models"],
                  "properties": {
                    "models": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "slug",
                          "name",
                          "lab",
                          "releaseDate",
                          "benchmarks"
                        ],
                        "properties": {
                          "slug": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "lab": {
                            "type": "string"
                          },
                          "releaseDate": {
                            "type": "string",
                            "format": "date",
                            "nullable": true
                          },
                          "benchmarks": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "required": ["benchmark", "value"],
                              "properties": {
                                "benchmark": {
                                  "type": "string"
                                },
                                "value": {
                                  "type": "number"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid selection",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Unknown model",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/model-suggestions/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "get": {
        "tags": ["Suggestions"],
        "operationId": "getModelSuggestion",
        "summary": "Get a suggestion by ID",
        "responses": {
          "200": {
            "description": "HTTP 200",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Suggestion"
                }
              }
            }
          },
          "400": {
            "description": "HTTP 400",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "HTTP 404",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Suggestions"],
        "operationId": "updateModelSuggestion",
        "summary": "Update a suggestion",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SuggestionInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "HTTP 200",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Suggestion"
                }
              }
            }
          },
          "400": {
            "description": "HTTP 400",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "HTTP 404",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Suggestions"],
        "operationId": "deleteModelSuggestion",
        "summary": "Delete a suggestion",
        "responses": {
          "204": {
            "description": "Suggestion deleted"
          },
          "400": {
            "description": "HTTP 400",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "HTTP 404",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/saved-comparisons": {
      "get": {
        "operationId": "getSavedComparison",
        "summary": "get saved comparisons",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "name", "models"],
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "models": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 10,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "maxLength": 120,
                          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Unknown comparison or selected model"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "operationId": "postSavedComparison",
        "summary": "post saved comparisons",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "models"],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "models": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 10,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "maxLength": 120,
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "name", "models"],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "models": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 10,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "maxLength": 120,
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Unknown comparison or selected model"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/saved-comparisons/{id}": {
      "get": {
        "operationId": "getSavedComparisonById",
        "summary": "get saved comparisons",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "name", "models"],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "models": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 10,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "maxLength": 120,
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Unknown comparison or selected model"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "put": {
        "operationId": "putSavedComparisonById",
        "summary": "put saved comparisons",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "models"],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "models": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 10,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "maxLength": 120,
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "name", "models"],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "models": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 10,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "maxLength": 120,
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Unknown comparison or selected model"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "delete": {
        "operationId": "deleteSavedComparisonById",
        "summary": "delete saved comparisons",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Unknown comparison or selected model"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/benchmarks": {
      "get": {
        "tags": ["Benchmarks"],
        "operationId": "listBenchmarks",
        "summary": "List benchmark scores for AI models",
        "responses": {
          "200": {
            "description": "List of benchmark scores",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BenchmarkEntry"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Benchmarks"],
        "operationId": "createBenchmark",
        "summary": "Create a benchmark score for an existing AI model",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BenchmarkInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Benchmark score created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BenchmarkEntry"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or missing required fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Model not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/benchmarks/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Composite benchmark score ID formatted as <modelId>-<benchmarkId>",
          "schema": {
            "type": "string",
            "pattern": "^[1-9][0-9]*-[1-9][0-9]*$"
          }
        }
      ],
      "get": {
        "tags": ["Benchmarks"],
        "operationId": "getBenchmarkById",
        "summary": "Retrieve a benchmark score by ID",
        "responses": {
          "200": {
            "description": "Benchmark score found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BenchmarkEntry"
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Benchmark not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Benchmarks"],
        "operationId": "updateBenchmark",
        "summary": "Update a benchmark score by ID",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BenchmarkUpdateInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Benchmark score updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BenchmarkEntry"
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID or fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Benchmark not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Benchmarks"],
        "operationId": "deleteBenchmark",
        "summary": "Delete a benchmark score by ID",
        "responses": {
          "204": {
            "description": "Benchmark score deleted"
          },
          "400": {
            "description": "Invalid ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Benchmark not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          }
        }
      },
      "Suggestion": {
        "type": "object",
        "required": ["id", "name", "provider"],
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "GPT-6"
          },
          "provider": {
            "type": "string",
            "example": "OpenAI"
          }
        }
      },
      "SuggestionInput": {
        "type": "object",
        "required": ["name", "provider"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "CatalogModel": {
        "type": "object",
        "required": ["name", "slug", "lab", "releaseDate"],
        "properties": {
          "name": {
            "type": "string"
          },
