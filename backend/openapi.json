{
  "openapi": "3.0.3",
  "info": {
    "title": "AI Models Comparator API",
    "version": "1.0.0",
    "description": "REST API for comparing AI models and submitting model suggestions."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "Catalog"
    },
    {
      "name": "Suggestions"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["Health"],
        "operationId": "getHealth",
        "summary": "Check API health",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/labs": {
      "get": {
        "tags": ["Catalog"],
        "operationId": "getLabs",
        "summary": "List available benchmark labs",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["labs"],
                  "properties": {
                    "labs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/models": {
      "get": {
        "tags": ["Catalog"],
        "operationId": "listModels",
        "summary": "List the AI models of the catalogue, optionally for one lab",
        "parameters": [
          {
            "name": "lab",
            "in": "query",
            "required": false,
            "description": "Exact lab name; an unknown lab gives an empty list",
            "schema": { "type": "string", "minLength": 1, "maxLength": 100 }
          }
        ],
        "responses": {
          "200": {
            "description": "Models sorted by name",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/CatalogModel" }
                }
              }
            }
          },
          "400": {
            "description": "Empty lab filter",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Catalog"],
        "operationId": "createModel",
        "summary": "Add an AI model to an existing lab",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewModelInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Model created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CatalogModel" }
              }
            }
          },
          "400": {
            "description": "Invalid or missing required fields",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "404": {
            "description": "Lab not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "409": {
            "description": "Model slug already exists",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/models/{slug}": {
      "get": {
        "tags": ["Catalog"],
        "operationId": "getModelBySlug",
        "summary": "Get an AI model by its slug",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "HTTP 400",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "HTTP 404",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/model-suggestions": {
      "get": {
        "tags": ["Suggestions"],
        "operationId": "listModelSuggestions",
        "summary": "List model suggestions",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Suggestion"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Suggestions"],
        "operationId": "createModelSuggestion",
        "summary": "Create a model suggestion",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SuggestionInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Suggestion"
                }
              }
            }
          },
          "400": {
            "description": "HTTP 400",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          }
        }
      },
      "Suggestion": {
        "type": "object",
        "required": ["id", "name", "provider"],
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "GPT-6"
          },
          "provider": {
            "type": "string",
            "example": "OpenAI"
          }
        }
      },
      "SuggestionInput": {
        "type": "object",
        "required": ["name", "provider"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "CatalogModel": {
        "type": "object",
        "required": ["name", "slug", "lab", "releaseDate"],
        "properties": {
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "lab": { "type": "string" },
          "releaseDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          }
        }
      },
      "NewModelInput": {
        "type": "object",
        "required": ["name", "slug", "lab"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "slug": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "lab": { "type": "string", "minLength": 1, "maxLength": 100 },
          "releaseDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
